@article{pham2025farl,
  title = {Fourier-Attentive Representation Learning: A Fourier-Guided Framework for Few-Shot Generalization in Vision-Language Models},
  author = {Hieu Dinh Trung Pham and Huy Minh Nhat Nguyen and Cuong Tuan Nguyen},
  journal = {arXiv},
  year = {2025},
  url = {https://arxiv.org/abs/2512.04395},
  arxiv = {2512.04395},
  abstract = {Large-scale pre-trained vision-language models have demonstrated strong few-shot learning capabilities. We propose a framework that explicitly disentangles visual representations using Fourier analysis and a dual cross-attention mechanism.}
}

@inproceedings{nguyen2025vehicle,
  title = {A Real-time Vehicle Detection Pipeline with Data-centric Enhancements and Multi-stage DETR Distillation},
  author = {Huy Minh Nhat Nguyen and Hieu Dinh Trung Pham and Khang Minh Le and Cuong Tuan Nguyen},
  booktitle = {2025 IEEE/CVF International Conference on Computer Vision Workshops (ICCVW)},
  year = {2025},
  month = {October},
  url = {https://openaccess.thecvf.com/content/ICCV2025W/AICity/papers/Nguyen_A_Real-time_Vehicle_Detection_Pipeline_with_Data-centric_Enhancements_and_Multi-stage_ICCVW_2025_paper.pdf},
  pages = {5382--5389},
  abstract = {Real-time vehicle detection often requires trading accuracy for speed. Our pipeline combines multi-stage DETR distillation, data-centric enhancements, and adaptive sample mining to achieve strong accuracy while maintaining real-time speed.}
}
