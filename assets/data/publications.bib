@inproceedings{le2026georoute,
  title = {GeoRoute: Geometry-Aware Hybrid Inference for Traffic Future-Frame Prediction},
  author = {Khang Minh Le and Hieu Dinh Trung Pham and Luu Thanh Danh and Nam-Tien Le and Hieu Anh Ngo and Phuong Huu Vu Tran and Son Nguyen Minh Le and Nguyen Trong Nghia and Tu Tran Thi Cam and Huy Minh Nhat Nguyen and Cuong Tuan Nguyen},
  booktitle = {European Conference on Computer Vision 2026 Workshops},
  year = {2026},
  month = {August},
  url = {https://arxiv.org/pdf/2608.09493},
  preprint = {arXiv},
  selected = {true},
  home_authors = {K. M. Le, H. D. T. Pham, ..., C. T. Nguyen},
  abstract = {Long-horizon future-frame prediction is important for autonomous driving, traffic surveillance, and intelligent transportation systems, yet remains challenging due to temporal ghosting, geometry drift, and inconsistent object motion. We present a training-free inference framework that stabilizes reliable static structure in pretrained video predictions through multi-frame temporal context and view-conditioned routing.}
}

@inproceedings{pham2026falcon,
  title = {FaLCon: Facet-Anchored Retrieval with Late Consensus for Sim2Real Text-Based Person Anomaly Search},
  author = {Hieu Dinh Trung Pham and Phuong Huu Vu Tran and Thuan Duc Mai and Son Nguyen Minh Le and Khang Le Minh and Hoang Vo and Minh-Chi Phung and Huy Minh Nhat Nguyen and Cuong Tuan Nguyen},
  booktitle = {European Conference on Computer Vision 2026 Workshops},
  year = {2026},
  month = {August},
  url = {https://arxiv.org/pdf/2608.09474},
  preprint = {arXiv},
  selected = {true},
  home_authors = {H. D. T. Pham, P. H. V. Tran, ..., C. T. Nguyen},
  abstract = {Text-based person anomaly search requires retrieving real-world pedestrian images from detailed natural-language descriptions using models trained primarily on synthetic data. We propose an anchor-constrained coarse-to-fine retrieval framework that combines global semantic matching with fine-grained verification.}
}

